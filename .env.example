# ===== Server =====
PORT=3000
NODE_ENV=development
# Isi "production" kalau sudah online (wajib pakai HTTPS)

# Secret sesi login admin: acak, minimal 24 karakter
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti_dengan_secret_acak_yang_panjang_dan_aman

# ===== Login Admin (/admin) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=isi_password_admin_yang_kuat

# ===== Info Pembayaran (tampil ke pembeli setelah order) =====
# Nomor WhatsApp admin untuk terima bukti bayar (format 62, tanpa + dan 0 di depan)
ADMIN_WHATSAPP=6281234567890

# QRIS: taruh gambar QRIS kamu di folder public/ (mis. public/qris.png), lalu isi:
PAY_QRIS_IMAGE=/qris.png

PAY_DANA_NUMBER=
PAY_DANA_NAME=

PAY_OVO_NUMBER=
PAY_OVO_NAME=

PAY_GOPAY_NUMBER=
PAY_GOPAY_NAME=

PAY_BANK_NAME=BCA
PAY_BANK_NUMBER=
PAY_BANK_HOLDER=

# Opsional: jumlah proxy di depan server (Nginx/Cloudflare = 1). Default 1 saat production.
# TRUST_PROXY=1
